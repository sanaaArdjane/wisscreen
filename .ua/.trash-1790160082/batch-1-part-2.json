   "id": "file:app/api/preview-status/route.ts",
   "type": "file",
   "name": "route.ts",
   "filePath": "app/api/preview-status/route.ts",
   "summary": "Server-side allowlisted probe that checks whether a solution's previewUrl permits being framed (X-Frame-Options / CSP frame-ancestors), so DeviceShowcase and SolutionHero know whether to show the live iframe or fall back to a screenshot.",
   "tags": [
    "api-handler",
    "security",
    "iframe",
    "ssrf-protection"
   ],
   "complexity": "complex",
   "languageNotes": "Reads X-Frame-Options/CSP server-side because browser-exposed signals cannot distinguish a cross-origin load from a framing refusal; the allowlist against SERVICES exists specifically to prevent an open SSRF proxy."
  },
