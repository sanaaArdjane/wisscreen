    {
      "id": "file:lib/crypto.ts",
      "type": "file",
      "name": "crypto.ts",
      "filePath": "lib/crypto.ts",
      "summary": "AES-256-GCM encryption at rest for demo secrets (passwords, SSH keys): a versioned base64url blob format, per-value random IV, and an AAD binding each ciphertext to its owning row so a copied ciphertext fails to decrypt elsewhere.",
      "tags": ["security", "crypto", "utility"],
      "complexity": "simple",
      "languageNotes": "Unlike every other optional integration in the project, this one does not degrade to a lesser feature when ENCRYPTION_KEY is unset — encryptSecret throws rather than ever storing a secret in plaintext."
    },
    {
      "id": "function:lib/crypto.ts:encryptionConfigured",
      "type": "function",
      "name": "encryptionConfigured",
      "filePath": "lib/crypto.ts",
      "lineRange": [28, 35],
      "summary": "Reports whether a valid 32-byte ENCRYPTION_KEY is set, by attempting to derive the key and catching failure.",
      "tags": ["security", "feature-flag"],
      "complexity": "simple"
    },
    {
      "id": "function:lib/crypto.ts:key",
      "type": "function",
      "name": "key",
      "filePath": "lib/crypto.ts",
      "lineRange": [37, 47],
      "summary": "Reads and validates ENCRYPTION_KEY from the environment as a 32-byte base64 buffer, throwing a descriptive error (including the openssl command to generate one) if missing or the wrong length.",
      "tags": ["security", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:lib/crypto.ts:encryptSecret",
      "type": "function",
      "name": "encryptSecret",
      "filePath": "lib/crypto.ts",
      "lineRange": [49, 56],
      "summary": "Encrypts a plaintext secret with AES-256-GCM under a random 12-byte IV and the caller-supplied AAD, returning a versioned `v1:iv:tag:ciphertext` base64url blob.",
      "tags": ["security", "crypto"],
      "complexity": "simple"
    },
    {
      "id": "function:lib/crypto.ts:decryptSecret",
      "type": "function",
      "name": "decryptSecret",
      "filePath": "lib/crypto.ts",
      "lineRange": [58, 69],
      "summary": "Decrypts a `v1:iv:tag:ciphertext` blob, verifying the auth tag against the caller-supplied AAD so a ciphertext moved to another row fails loudly instead of decrypting.",
      "tags": ["security", "crypto"],
      "complexity": "simple"
    },
    {
      "id": "function:lib/crypto.ts:demoSecretAad",
      "type": "function",
      "name": "demoSecretAad",
      "filePath": "lib/crypto.ts",
      "lineRange": [72, 74],
      "summary": "Builds the single canonical AAD string (`demo:<demoId>:<blockId>:<label>`) shared by every writer and reader of a demo secret, so the binding can never drift between the two.",
      "tags": ["security", "utility"],
      "complexity": "simple"
    },
