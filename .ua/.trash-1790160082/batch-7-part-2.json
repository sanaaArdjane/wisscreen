   "name": "actions.ts",
   "filePath": "app/(app)/admin/factures/actions.ts",
   "summary": "Server actions for the invoice lifecycle: save (create/update, refuses paid/cancelled invoices), send/resend by e-mail (issues on first send, stamps issuedAt), status transitions (stamps issuedAt/paidAt on the transition rather than recomputing, notifies the client when marked paid), and delete (plain confirm for drafts, reference-typed confirm once emitted).",
   "tags": [
    "server-action",
    "admin",
    "billing",
    "invoices",
    "workflow"
   ],
   "complexity": "complex"
  },
