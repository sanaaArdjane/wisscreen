{"nodes": [{"id": "file:app/(app)/admin/notifications/page.tsx", "type": "file", "name": "page.tsx", "filePath": "app/(app)/admin/notifications/page.tsx", "summary": "Staff member's own notification feed at /admin/notifications \u2014 the page the bell in the admin top bar points at, replacing what used to be the broadcast composer (now moved to /admin/notifications/envoyer).", "tags": ["api-handler", "notifications", "admin", "dashboard-page"], "complexity": "simple"}, {"id": "function:app/(app)/admin/notifications/page.tsx:AdminNotificationsPage", "type": "function", "name": "AdminNotificationsPage", "filePath": "app/(app)/admin/notifications/page.tsx", "lineRange": [26, 65], "summary": "Loads the signed-in staff member's last 100 notifications ordered by recency, counts unread, and renders them via NotificationFeed with an optional 'send notification' CTA gated by notifications:write.", "tags": ["api-handler", "server-component", "notifications"], "complexity": "simple"}, {"id": "file:app/(app)/admin/page.tsx", "type": "file", "name": "page.tsx", "filePath": "app/(app)/admin/page.tsx", "summary": "Back-office home (/admin): a permission-gated dashboard of stat tiles (open requests, pending quotes, unpaid invoices, accounts), the open-requests queue, recently registered users, and the activity journal \u2014 each block only rendered if the signed-in staff member holds the matching read permission.", "tags": ["admin", "dashboard-page", "entry-point"], "complexity": "moderate"}, {"id": "function:app/(app)/admin/page.tsx:AdminHome", "type": "function", "name": "AdminHome", "filePath": "app/(app)/admin/page.tsx", "lineRange": [19, 221], "summary": "Fetches, in parallel and permission-gated, admin counters, the open-requests queue, the six most recent users, and the last eight activity-log entries, then lays them out as stat tiles and panels.", "tags": ["server-component", "admin", "aggregation"], "complexity": "moderate"}, {"id": "file:app/(app)/admin/profil/page.tsx", "type": "file", "name": "page.tsx", "filePath": "app/(app)/admin/profil/page.tsx", "summary": "Staff member's own profile inside the admin shell (/admin/profil) \u2014 the same identity/password/sessions forms as the client-facing profile, plus a read-only account panel showing role, granted-permission count and magic-link status, so staff never leave the back-office to manage their account.", "tags": ["admin", "profile", "dashboard-page"], "complexity": "simple"}, {"id": "function:app/(app)/admin/profil/page.tsx:AdminProfilPage", "type": "function", "name": "AdminProfilPage", "filePath": "app/(app)/admin/profil/page.tsx", "lineRange": [32, 98], "summary": "Loads the current staff member and session, checks whether a credential (password) account exists, counts granted permissions via effectivePermissions, and renders the identity/password/session panels plus a delete-account panel hidden for admins.", "tags": ["server-component", "admin", "profile"], "complexity": "simple"}, {"id": "file:app/(app)/admin/site/layout.tsx", "type": "file", "name": "layout.tsx", "filePath": "app/(app)/admin/site/layout.tsx", "summary": "Layout for /admin/site (the owner-editable public-site content editor): gates reads behind site:read, renders the page header with an 'open the live site' link, and wraps children with SiteTabs for section navigation.", "tags": ["admin", "layout", "site-content", "access-control"], "complexity": "simple"}, {"id": "function:app/(app)/admin/site/layout.tsx:SiteLayout", "type": "function", "name": "SiteLayout", "filePath": "app/(app)/admin/site/layout.tsx", "lineRange": [10, 34], "summary": "Requires the site:read permission, then renders the shared PageHeader and SiteTabs around the /admin/site child routes (hero, sections, solutions, contact, SEO editors).", "tags": ["server-component", "layout", "guard"], "complexity": "simple"}, {"id": "file:app/(app)/admin/utilisateurs/[id]/page.tsx", "type": "file", "name": "page.tsx", "filePath": "app/(app)/admin/utilisateurs/[id]/page.tsx", "summary": "Admin user detail page (/admin/utilisateurs/[id]) \u2014 the fiche for one account: stat tiles, editable profile and permission-matrix forms (permission-gated), subscribed services, quota meters/editors, recent requests, plus a message/impersonate/suspend/delete side column with the last-active-admin and self-action invariants reflected in what renders.", "tags": ["admin", "user-management", "dashboard-page", "permissions"], "complexity": "complex"}, {"id": "function:app/(app)/admin/utilisateurs/[id]/page.tsx:UserDetailPage", "type": "function", "name": "UserDetailPage", "filePath": "app/(app)/admin/utilisateurs/[id]/page.tsx", "lineRange": [43, 313], "summary": "Requires users:read, loads the target user plus their subscriptions, quotas and last 10 requests, computes isSelf/mayWriteUsers/mayWriteTeam/mayWriteSubs, and renders the full account fiche with role-form, permission matrix (remounted on role change), services, quotas, requests and staff-only action panels.", "tags": ["server-component", "admin", "user-management"], "complexity": "complex"}, {"id": "file:app/(app)/admin/utilisateurs/actions.ts", "type": "file", "name": "actions.ts", "filePath": "app/(app)/admin/utilisateurs/actions.ts", "summary": "Server actions for back-office account administration (create, suspend/unsuspend, edit, role/permission changes, quota edit/delete, message, impersonate, delete). Enforces three invariants in code rather than the UI: nobody acts on their own account, the last active admin can never be demoted/suspended/deleted, and only team:write may change roles or permissions.", "tags": ["admin", "user-management", "server-action", "authorization"], "complexity": "complex", "languageNotes": "Uses Better Auth's own auth.api.createUser/banUser/unbanUser/impersonateUser endpoints instead of hand-rolled UPDATEs so password hashing, session revocation and the credential row stay consistent with sign-in."}, {"id": "function:app/(app)/admin/utilisateurs/actions.ts:adminCount", "type": "function", "name": "adminCount", "filePath": "app/(app)/admin/utilisateurs/actions.ts", "lineRange": [36, 45], "summary": "Counts active (non-banned) admin accounts with `is not true` rather than `= false` on the nullable banned column, so an admin who has never been banned is still counted.", "tags": ["query", "admin", "invariant"], "complexity": "simple"}, {"id": "function:app/(app)/admin/utilisateurs/actions.ts:createAccount", "type": "function", "name": "createAccount", "filePath": "app/(app)/admin/utilisateurs/actions.ts", "lineRange": [101, 192], "summary": "Creates a staff-side account via auth.api.createUser (never a raw INSERT, so the password hash and credential row match what sign-in verifies), generating a rule-compliant password when left blank, requiring team:write to create anything above a client role, and optionally e-mailing the invite.", "tags": ["server-action", "admin", "user-management", "authorization"], "complexity": "complex"}, {"id": "function:app/(app)/admin/utilisateurs/actions.ts:suspendUser", "type": "function", "name": "suspendUser", "filePath": "app/(app)/admin/utilisateurs/actions.ts", "lineRange": [201, 231], "summary": "Bans a user through auth.api.banUser (which also revokes their live sessions), blocked from targeting the caller's own account or the last active admin.", "tags": ["server-action", "admin", "authorization"], "complexity": "moderate"}, {"id": "function:app/(app)/admin/utilisateurs/actions.ts:unsuspendUser", "type": "function", "name": "unsuspendUser", "filePath": "app/(app)/admin/utilisateurs/actions.ts", "lineRange": [233, 246], "summary": "Lifts a ban via auth.api.unbanUser and logs the action; a plain non-returning form action used with React's action prop.", "tags": ["server-action", "admin"], "complexity": "simple"}, {"id": "function:app/(app)/admin/utilisateurs/actions.ts:updateUser", "type": "function", "name": "updateUser", "filePath": "app/(app)/admin/utilisateurs/actions.ts", "lineRange": [259, 285], "summary": "Updates a target account's name/phone/company/admin note/magic-link flag, requiring users:write.", "tags": ["server-action", "admin", "profile"], "complexity": "simple"}, {"id": "function:app/(app)/admin/utilisateurs/actions.ts:changeRole", "type": "function", "name": "changeRole", "filePath": "app/(app)/admin/utilisateurs/actions.ts", "lineRange": [294, 326], "summary": "Changes a user's role, requiring team:write, refusing self-demotion and demoting the last active admin, and notifying the target of the change.", "tags": ["server-action", "admin", "authorization"], "complexity": "moderate"}, {"id": "function:app/(app)/admin/utilisateurs/actions.ts:updatePermissions", "type": "function", "name": "updatePermissions", "filePath": "app/(app)/admin/utilisateurs/actions.ts", "lineRange": [340, 386], "summary": "Rebuilds a user's permission overrides from a fully-posted checkbox matrix: only deviations from the target role's defaults are stored, so a later role promotion isn't overruled by a frozen snapshot.", "tags": ["server-action", "admin", "authorization", "permissions"], "complexity": "moderate"}, {"id": "function:app/(app)/admin/utilisateurs/actions.ts:setQuota", "type": "function", "name": "setQuota", "filePath": "app/(app)/admin/utilisateurs/actions.ts", "lineRange": [401, 431], "summary": "Upserts a quota row (limit/used) for a user, requiring subscriptions:write, resetting the period only for non-standing metrics.", "tags": ["server-action", "admin", "quotas"], "complexity": "moderate"}, {"id": "function:app/(app)/admin/utilisateurs/actions.ts:deleteQuota", "type": "function", "name": "deleteQuota", "filePath": "app/(app)/admin/utilisateurs/actions.ts", "lineRange": [434, 449], "summary": "Removes a metric row from a user's quotas, which per the quota rules makes that metric unlimited again.", "tags": ["server-action", "admin", "quotas"], "complexity": "simple"}, {"id": "function:app/(app)/admin/utilisateurs/actions.ts:messageUser", "type": "function", "name": "messageUser", "filePath": "app/(app)/admin/utilisateurs/actions.ts", "lineRange": [460, 498], "summary": "Sends an in-app notification to a target user and optionally an e-mail, requiring notifications:write.", "tags": ["server-action", "admin", "notifications"], "complexity": "moderate"}, {"id": "function:app/(app)/admin/utilisateurs/actions.ts:impersonate", "type": "function", "name": "impersonate", "filePath": "app/(app)/admin/utilisateurs/actions.ts", "lineRange": [500, 514], "summary": "Starts a Better Auth impersonation session for the target user and redirects the staff member to /dashboard, refusing self-impersonation.", "tags": ["server-action", "admin", "authentication"], "complexity": "simple"}, {"id": "function:app/(app)/admin/utilisateurs/actions.ts:deleteUser", "type": "function", "name": "deleteUser", "filePath": "app/(app)/admin/utilisateurs/actions.ts", "lineRange": [521, 555], "summary": "Permanently deletes a user account after the admin types the exact e-mail as confirmation, refusing self-deletion and deletion of the last active admin.", "tags": ["server-action", "admin", "destructive"], "complexity": "moderate"}], "edges": [{"source": "file:app/(app)/admin/notifications/page.tsx", "target": "function:app/(app)/admin/notifications/page.tsx:AdminNotificationsPage", "type": "contains", "direction": "forward", "weight": 1.0}, {"source": "file:app/(app)/admin/notifications/page.tsx", "target": "function:app/(app)/admin/notifications/page.tsx:AdminNotificationsPage", "type": "exports", "direction": "forward", "weight": 0.8}, {"source": "function:app/(app)/admin/notifications/page.tsx:AdminNotificationsPage", "target": "function:lib/guard.ts:requireStaff", "type": "calls", "direction": "forward", "weight": 0.8}, {"source": "function:app/(app)/admin/notifications/page.tsx:AdminNotificationsPage", "target": "function:lib/permissions.ts:can", "type": "calls", "direction": "forward", "weight": 0.8}, {"so