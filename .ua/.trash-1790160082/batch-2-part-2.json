   "name": "DeviceShowcase.tsx",
   "filePath": "components/sections/DeviceShowcase.tsx",
   "summary": "Pinned, scroll-driven homepage section showing every solution running live on a drawn laptop and phone at once, with per-solution tabs, activation-shielded iframes (live previews with screenshot/mock fallback), and a zoom-to-fullscreen control for each device.",
   "tags": [
    "marketing-section",
    "scroll-driven",
    "complex-interaction",
    "client-component"
   ],
   "complexity": "complex",
   "languageNotes": "Scroll progress is the single source of truth for the active tab; layers never remount once mounted, and zoom is implemented as a CSS transform rather than a layout resize to avoid reflowing embedded cross-origin pages."
  },
