    "pdf",
    "billing",
    "react-pdf",
    "rendering"
   ],
   "complexity": "complex",
   "languageNotes": "`clean()` strips U+202F (the French `Intl` thousands separator) because Helvetica's built-in font can't render it; every printed string goes through it."
  },
