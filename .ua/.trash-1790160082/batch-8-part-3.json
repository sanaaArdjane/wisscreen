  {
   "id": "file:lib/pdf/BillingDocument.tsx",
   "type": "file",
   "name": "BillingDocument.tsx",
   "filePath": "lib/pdf/BillingDocument.tsx",
   "summary": "`@react-pdf/renderer` document component rendering a devis or facture as a styled A4 PDF \u2014 header, client block, line-item table, totals, bank details and legal footer \u2014 using company identity resolved per document.",
