{"nodes": [{"id": "file:app/(app)/dashboard/page.tsx", "type": "file", "name": "page.tsx", "filePath": "app/(app)/dashboard/page.tsx", "summary": "Client dashboard home (/dashboard): a 'to-do first' layout \u2014 pending quotes and unpaid invoices at the top (the one thing blocking the agency's own work), stat tiles, recent requests, live services with hot-usage quota meters, entitled demos with expiry countdowns, and recent notifications.", "tags": ["dashboard-page", "entry-point", "billing", "requests"], "complexity": "complex"}, {"id": "function:app/(app)/dashboard/page.tsx:DashboardHome", "type": "function", "name": "DashboardHome", "filePath": "app/(app)/dashboard/page.tsx", "lineRange": [37, 303], "summary": "Loads counters, recent requests, subscriptions, quota usage, entitled demos, recent notifications, pending quotes and overdue-or-sent invoices in parallel, computes per-document TTC via effectiveCompany/withVat, and renders the prioritized dashboard layout.", "tags": ["server-component", "dashboard-page", "billing", "aggregation"], "complexity": "complex"}, {"id": "file:app/(app)/dashboard/profil/actions.ts", "type": "file", "name": "actions.ts", "filePath": "app/(app)/dashboard/profil/actions.ts", "summary": "Client profile server action: updates identity fields only (name/phone/company). E-mail is deliberately not editable here \u2014 changing it is an authentication change that needs Better Auth's changeEmail verification flow, not yet wired up.", "tags": ["server-action", "profile"], "complexity": "simple"}, {"id": "function:app/(app)/dashboard/profil/actions.ts:updateProfile", "type": "function", "name": "updateProfile", "filePath": "app/(app)/dashboard/profil/actions.ts", "lineRange": [27, 52], "summary": "Validates and writes name/phone/company for the current user, logs the activity, and revalidates both the dashboard and admin layouts (since staff edit their profile from inside /admin too).", "tags": ["server-action", "profile"], "complexity": "simple"}, {"id": "file:app/(app)/dashboard/profil/page.tsx", "type": "file", "name": "page.tsx", "filePath": "app/(app)/dashboard/profil/page.tsx", "summary": "Client profile page (/dashboard/profil): identity, password (only offered if a credential account exists \u2014 a Google-only account has none), connected-sessions list, and account deletion, plus a read-only account summary panel.", "tags": ["dashboard-page", "profile"], "complexity": "simple"}, {"id": "function:app/(app)/dashboard/profil/page.tsx:ProfilPage", "type": "function", "name": "ProfilPage", "filePath": "app/(app)/dashboard/profil/page.tsx", "lineRange": [18, 81], "summary": "Requires an authenticated user, checks for a credential account, and renders the identity/password/session/delete panels alongside a role/verification/membership summary.", "tags": ["server-component", "dashboard-page", "profile"], "complexity": "moderate"}, {"id": "file:app/(auth)/acces-refuse/page.tsx", "type": "file", "name": "page.tsx", "filePath": "app/(auth)/acces-refuse/page.tsx", "summary": "The 403 landing page (/acces-refuse) that requirePermission() redirects a signed-in-but-unauthorized staff member to, naming the missing permission in plain French (e.g. 'Factures \u2192 Modifier') so it's actionable, with links back into /admin or /dashboard.", "tags": ["auth", "error-page", "permissions"], "complexity": "simple"}, {"id": "function:app/(auth)/acces-refuse/page.tsx:AccesRefusePage", "type": "function", "name": "AccesRefusePage", "filePath": "app/(auth)/acces-refuse/page.tsx", "lineRange": [13, 43], "summary": "Parses the ?perm= query param into a domain:action pair, looks up human-readable labels from DOMAIN_LABELS/ACTION_LABELS, and renders the access-denied message with links back to admin or the client dashboard.", "tags": ["server-component", "error-page", "permissions"], "complexity": "simple"}, {"id": "file:app/api/contact/route.ts", "type": "file", "name": "route.ts", "filePath": "app/api/contact/route.ts", "summary": "POST /api/contact \u2014 the public contact-form endpoint: verifies Cloudflare Turnstile (skipped if unconfigured, never breaking the form outright), stores the submission as a contact_leads row (previously it verified and silently dropped the message), notifies staff with leads:read, and e-mails the admin as a convenience copy.", "tags": ["api-handler", "contact-form", "public-endpoint"], "complexity": "simple"}, {"id": "function:app/api/contact/route.ts:verifyTurnstile", "type": "function", "name": "verifyTurnstile", "filePath": "app/api/contact/route.ts", "lineRange": [34, 53], "summary": "POSTs the Turnstile response token to Cloudflare's siteverify endpoint with an 8s timeout, returning true when TURNSTILE_SECRET_KEY is unset (feature disabled rather than blocking every submission) and false on any error or non-success response.", "tags": ["validation", "captcha", "external-api"], "complexity": "simple"}, {"id": "function:app/api/contact/route.ts:POST", "type": "function", "name": "POST", "filePath": "app/api/contact/route.ts", "lineRange": [55, 110], "summary": "Parses and validates the contact form, verifies Turnstile, inserts a contact_leads row, notifies staff, and e-mails the admin \u2014 the database write, not the e-mail, is the record of truth so a down mail provider never turns a stored lead into a visible error.", "tags": ["api-handler", "contact-form", "public-endpoint"], "complexity": "moderate"}, {"id": "file:app/api/demos/secret/route.ts", "type": "file", "name": "route.ts", "filePath": "app/api/demos/secret/route.ts", "summary": "POST /api/demos/secret \u2014 reveals one demo secret (test password, SSH key) to an entitled customer or demos:read staff and logs the reveal. A route rather than a server action because it returns a value to already-hydrated JS and needs Cache-Control: no-store; every condition (session, ban, entitlement, expiry, that the block still declares the secret) is re-checked from scratch rather than trusting the page that rendered the button.", "tags": ["api-handler", "demos", "security", "encryption"], "complexity": "moderate"}, {"id": "function:app/api/demos/secret/route.ts:POST", "type": "function", "name": "POST", "filePath": "app/api/demos/secret/route.ts", "lineRange": [34, 104], "summary": "Authenticates the caller, requires ENCRYPTION_KEY to be configured, re-derives entitlement (staff with demos:read bypass it), confirms the block still declares the requested secret and isn't expired, decrypts the ciphertext with the demo/block/label AAD, increments the reveal counter, logs the reveal, and returns the plaintext with no-store headers \u2014 refusals are 404s rather than 403s so the existence of a named secret is never leaked.", "tags": ["api-handler", "demos", "security", "encryption", "authorization"], "complexity": "moderate"}], "edges": [{"source": "file:app/(app)/dashboard/page.tsx", "target": "function:app/(app)/dashboard/page.tsx:DashboardHome", "type": "contains", "direction": "forward", "weight": 1.0}, {"source": "file:app/(app)/dashboard/page.tsx", "target": "function:app/(app)/dashboard/page.tsx:DashboardHome", "type": "exports", "direction": "forward", "weight": 0.8}, {"source": "function:app/(app)/dashboard/page.tsx:DashboardHome", "target": "function:lib/guard.ts:requireUser", "type": "calls", "direction": "forward", "weight": 0.8}, {"source": "function:app/(app)/dashboard/page.tsx:DashboardHome", "target": "function:lib/server/queries.ts:clientCounters", "type": "calls", "direction": "forward", "weight": 0.8}, {"source": "function:app/(app)/dashboard/page.tsx:DashboardHome", "target": "function:lib/server/queries.ts:listRequests", "type": "calls", "direction": "forward", "weight": 0.8}, {"source": "function:app/(app)/dashboard/page.tsx:DashboardHome", "target": "function:lib/quotas.ts:listSubscriptions", "type": "calls", "direction": "forward", "weight": 0.8}, {"source": "function:app/(app)/dashboard/page.tsx:DashboardHome", "target": "function:lib/quota