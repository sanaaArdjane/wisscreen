{"nodes": [{"id": "file:app/(app)/dashboard/demos/actions.ts", "type": "file", "name": "actions.ts", "filePath": "app/(app)/dashboard/demos/actions.ts", "summary": "Customer-side server actions for the 'upload' demo block: start a processing run (re-checking entitlement and spending the demo.processing quota, currently unlimited since no service grants it) and submit an in-progress run once files are attached, notifying the desk.", "tags": ["server-action", "demos", "quotas", "client-facing"], "complexity": "simple"}, {"id": "function:app/(app)/dashboard/demos/actions.ts:startDemoRun", "type": "function", "name": "startDemoRun", "filePath": "app/(app)/dashboard/demos/actions.ts", "lineRange": [21, 82], "summary": "Re-derives demo entitlement, reuses an already-open run instead of creating a duplicate, spends the demo.processing quota (recording a 'quota' outcome on refusal), and inserts a new pending run on success.", "tags": ["server-action", "demos", "quotas"], "complexity": "moderate"}, {"id": "function:app/(app)/dashboard/demos/actions.ts:submitDemoRun", "type": "function", "name": "submitDemoRun", "filePath": "app/(app)/dashboard/demos/actions.ts", "lineRange": [85, 127], "summary": "Transitions a pending run with at least one uploaded attachment to 'en_cours' and notifies staff with demos:read that a file is ready to process.", "tags": ["server-action", "demos", "notifications"], "complexity": "moderate"}, {"id": "file:app/(app)/dashboard/devis/[id]/actions.ts", "type": "file", "name": "actions.ts", "filePath": "app/(app)/dashboard/devis/[id]/actions.ts", "summary": "Client's accept/refuse decision on a quote (devis): a single UPDATE whose WHERE clause enforces both ownership and that the quote is still in 'envoye' status (so a replayed form post after withdrawal is a no-op), followed by staff notification and an admin e-mail.", "tags": ["server-action", "billing", "quotes", "client-facing"], "complexity": "simple"}, {"id": "function:app/(app)/dashboard/devis/