rkAllReadButton.tsx:MarkAllReadButton", "type": "function", "name": "MarkAllReadButton", "filePath": "app/(app)/dashboard/notifications/MarkAllReadButton.tsx", "lineRange": [7, 15], "summary": "Renders a form bound to the markAllRead server action with a submit button.", "tags": ["component", "client-component", "notifications"], "complexity": "simple"}, {"id": "function:app/(app)/dashboard/notifications/MarkAllReadButton.tsx:ClearReadButton", "type": "function", "name": "ClearReadButton", "filePath": "app/(app)/dashboard/notifications/MarkAllReadButton.tsx", "lineRange": [17, 26], "summary": "Renders ConfirmButton wired to the clearRead server action, with a count-aware confirm label and a warning that unread notifications are kept.", "tags": ["component", "client-component", "notifications", "destructive"], "complexity": "simple"}, {"id": "file:app/(app)/dashboard/notifications/actions.ts", "type": "file", "name": "actions.ts", "filePath": "app/(app)/dashboard/notifications/actions.ts", "summary": "Server actions for a client's own notification feed (mark-all-read, mark-one-read, delete-one, clear-read): every statement is scoped to the caller by its WHERE, so there is no permission key involved, only ownership; each ends by publishing a realtime nudge and revalidating both shell layouts.", "tags": ["server-action", "notifications", "realtime"], "complexity": "simple"}, {"id": "function:app/(app)/dashboard/notifications/actions.ts:markAllRead", "type": "function", "name": "markAllRead", "filePath": "app/(app)/dashboard/notifications/actions.ts", "lineRange": [24, 31], "summary": "Marks every unread notification belonging to the caller as read.", "tags": ["server-action", "notifications"], "complexity": "simple"}, {"id": "function:app/(app)/dashboard/notifications/actions.ts:markRead", "type": "function", "name": "markRead", "filePath": "app/(app)/dashboard/notifications/actions.ts", "lineRange": [33, 42], "summary": "Marks a single notification owned by the caller