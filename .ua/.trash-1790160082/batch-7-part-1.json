    "billing",
    "node-environment"
   ],
   "complexity": "moderate"
  },
  {
   "id": "file:__tests__/platform.test.ts",
   "type": "file",
   "name": "platform.test.ts",
   "filePath": "__tests__/platform.test.ts",
   "summary": "Pins the dashboard's pure decision logic with no database involved: the can()/isStaff() authorization model, request status transitions, WC/DV/FA reference-code sequencing, money math (line totals, VAT-free parsing/formatting), quota progress (unlimited vs not-included vs remaining), and derived billing status (en_retard, expired quotes) — documented as rules a UI control and a server action both rely on, so a regression here is a silent authorization or billing bug.",
   "tags": [
    "test",
    "permissions",
    "billing",
    "quotas",
    "unit-test"
   ],
   "complexity": "complex"
  },
