# Build context excludes — keep the image small and secrets out of it.
# Anything the build needs (source, package.json, pnpm-lock.yaml,
# pnpm-workspace.yaml, next.config.ts, tsconfig.json, postcss/eslint config,
# public/) is intentionally NOT listed here.

# Dependencies are reinstalled inside the image.
node_modules
.pnpm-store

# Build output (regenerated by `pnpm build` in the builder stage).
.next
out
build
coverage

# VCS / CI / editor.
.git
.gitignore
.github
.vscode
.idea

# Secrets — must never be baked into an image layer.
.env
.env.*
!.env.example

# Local tooling / docs not needed at build or runtime.
Dockerfile
.dockerignore
README.md
AGENTS.md
CLAUDE.md
scripts
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
